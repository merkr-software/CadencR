+// TestRunExitsOnTransportEOFWhileAwaitingClientResponse covers a client that
+// closes its transport while initialized awaits client/registerCapability.
+// Transport EOF must still end the server instead of waiting behind the handler.
+func TestRunExitsOnTransportEOFWhileAwaitingClientResponse(t *testing.T) {
+	t.Parallel()
+
+	if !bundled.Embedded {
+		t.Skip("bundled files are not embedded")
+	}
+
+	serverIn, clientOut := io.Pipe()
+	clientIn, serverOut := io.Pipe()
+	server := NewServer(&ServerOptions{
+		In:                 ToReader(serverIn),
+		Out:                ToWriter(serverOut),
+		Err:                io.Discard,
+		Cwd:                "/test",
+		FS:                 bundled.WrapFS(vfstest.FromMap(map[string]string{"/test/tsconfig.json": "{}"}, false)),
+		DefaultLibraryPath: bundled.LibPath(),
+	})
+	done := make(chan error, 1)
+	go func() { done <- server.Run(t.Context()) }()
+
+	// Drain every server message so the writer never blocks; signal the pending request.
+	awaiting := make(chan struct{})
+	go func() {
+		reader := ToReader(clientIn)
+		signaled := false
+		for {
+			msg, err := reader.Read()
+			if err != nil {
+				return
+			}
+			if !signaled && msg.Kind == jsonrpc.MessageKindRequest && msg.AsRequest().Method == lsproto.MethodClientRegisterCapability {
+				signaled = true
+				close(awaiting)
+			}
+		}
+	}()
+
+	for _, body := range []string{
+		`{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":"file:///test","capabilities":{"workspace":{"didChangeWatchedFiles":{"dynamicRegistration":true}}}}}`,
+		`{"jsonrpc":"2.0","method":"initialized","params":{}}`,
+	} {
+		if _, err := fmt.Fprintf(clientOut, "Content-Length: %d\r\n\r\n%s", len(body), body); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	timeout := time.After(10 * time.Second)
+	select {
+	case <-awaiting:
+	case err := <-done:
+		t.Fatalf("Run() returned %v before the client request was pending", err)
+	case <-timeout:
+		t.Fatal("server never requested client/registerCapability")
+	}
+	if err := clientOut.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("Run() error = %v, want nil", err)
+		}
+	case <-timeout:
+		t.Fatal("Run() did not return after transport EOF while a client response was pending")
+	}
+}
