 func (shutdownTestWriter) Write(*lsproto.Message) error { return nil }
 
+// scriptedTestReader delivers messages, then either reports transport EOF or
+// blocks so that only a protocol exit can end the server.
+type scriptedTestReader struct {
+	messages []*lsproto.Message
+	eof      bool
+	release  chan struct{}
+}
+
+func (r *scriptedTestReader) Read() (*lsproto.Message, error) {
+	if len(r.messages) > 0 {
+		msg := r.messages[0]
+		r.messages = r.messages[1:]
+		return msg, nil
+	}
+	if !r.eof {
+		<-r.release
+	}
+	return nil, io.EOF
+}
+
+type failingTestWriter struct{ err error }
+
+func (w failingTestWriter) Write(*lsproto.Message) error { return w.err }
+
+type lifecycleTest struct {
+	messages          []*lsproto.Message
+	eof               bool
+	initialized       bool
+	shutdownRequested bool
+	out               Writer
+}
+
+func (test lifecycleTest) run(t *testing.T, ctx context.Context) error {
+	t.Helper()
+	reader := &scriptedTestReader{messages: test.messages, eof: test.eof, release: make(chan struct{})}
+	t.Cleanup(func() { close(reader.release) })
+	out := test.out
+	if out == nil {
+		out = shutdownTestWriter{}
+	}
+	server := NewServer(&ServerOptions{In: reader, Out: out, Err: io.Discard, Cwd: "/test"})
+	if test.initialized {
+		server.initializeParams = &lsproto.InitializeParams{}
+		server.session = &project.Session{}
+	}
+	server.shutdownRequested.Store(test.shutdownRequested)
+	return server.Run(ctx)
+}
+
+func exitMessage() *lsproto.Message {
+	return (&lsproto.RequestMessage{Method: lsproto.MethodExit}).Message()
+}
+
+func TestRunExitStatus(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range []struct {
+		name string
+		test lifecycleTest
+		want error
+	}{
+		{"exit after shutdown with open transport", lifecycleTest{messages: []*lsproto.Message{exitMessage()}, initialized: true, shutdownRequested: true}, nil},
+		{"exit after shutdown followed by immediate EOF", lifecycleTest{messages: []*lsproto.Message{exitMessage()}, eof: true, initialized: true, shutdownRequested: true}, nil},
+		{"exit before shutdown with open transport", lifecycleTest{messages: []*lsproto.Message{exitMessage()}, initialized: true}, errExitBeforeShutdown},
+		{"exit before initialize", lifecycleTest{messages: []*lsproto.Message{exitMessage()}}, errExitBeforeShutdown},
+		{"transport EOF without exit", lifecycleTest{eof: true, initialized: true}, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			if err := tc.test.run(t, t.Context()); !errors.Is(err, tc.want) {
+				t.Fatalf("Run() error = %v, want %v", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestRunReportsParentCancellation(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := (lifecycleTest{initialized: true, shutdownRequested: true}).run(t, ctx); !errors.Is(err, context.Canceled) {
