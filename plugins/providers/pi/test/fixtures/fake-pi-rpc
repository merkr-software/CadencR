#!/usr/bin/env node

import { createInterface } from "node:readline";
import { existsSync, readFileSync, writeFileSync } from "node:fs";

const models = [
  {
    provider: "fake",
    id: "small",
    name: "Fake Small",
    reasoning: false,
    input: ["text"],
    contextWindow: 8192,
  },
  {
    provider: "fake",
    id: "reasoning",
    name: "Fake Reasoning",
    reasoning: true,
    input: ["text", "image"],
    contextWindow: 32768,
    thinkingLevelMap: { xhigh: "xhigh" },
  },
];
let model = models[0];
let thinkingLevel = "off";
let autoCompactionEnabled = true;
let steeringMode = "all";
let followUpMode = "all";
let activePrompt = null;
let messageCount = 0;
let memory = "";

const stateFile = process.env.FAKE_PI_STATE_FILE;
const sessionArgumentIndex = process.argv.indexOf("--session");
const requestedSessionId =
  sessionArgumentIndex === -1 ? null : process.argv[sessionArgumentIndex + 1];

if (requestedSessionId) {
  if (!stateFile || !existsSync(stateFile)) {
    process.stderr.write(`No session found matching '${requestedSessionId}'\n`);
    process.exit(1);
  }
  const saved = JSON.parse(readFileSync(stateFile, "utf8"));
  if (saved.sessionId !== requestedSessionId) {
    process.stderr.write(`No session found matching '${requestedSessionId}'\n`);
    process.exit(1);
  }
  model = models.find((entry) => entry.provider === saved.provider && entry.id === saved.modelId) ?? model;
  thinkingLevel = saved.thinkingLevel ?? thinkingLevel;
  autoCompactionEnabled = saved.autoCompactionEnabled ?? autoCompactionEnabled;
  steeringMode = saved.steeringMode ?? steeringMode;
  followUpMode = saved.followUpMode ?? followUpMode;
  messageCount = saved.messageCount ?? messageCount;
  memory = saved.memory ?? memory;
} else {
  persistState();
}

function persistState() {
  if (!stateFile) return;
  writeFileSync(
    stateFile,
    JSON.stringify({
      sessionId: "fake-pi-rpc-session",
      provider: model.provider,
      modelId: model.id,
      thinkingLevel,
      autoCompactionEnabled,
      steeringMode,
      followUpMode,
      messageCount,
      memory,
    }),
  );
}

function output(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`);
}

function response(request, data) {
  output({ id: request.id, type: "response", command: request.type, success: true, ...(data === undefined ? {} : { data }) });
}

function state() {
  return {
    model,
    thinkingLevel,
    isStreaming: activePrompt !== null,
    isCompacting: false,
    steeringMode,
    followUpMode,
    sessionId: "fake-pi-rpc-session",
    autoCompactionEnabled,
    messageCount,
    pendingMessageCount: 0,
  };
}

function assistant(text, stopReason = "stop") {
  return {
    role: "assistant",
    content: [{ type: "text", text }],
    provider: model.provider,
    model: model.id,
    usage: {
      input: 10,
      output: 5,
      cacheRead: 0,
      cacheWrite: 0,
      totalTokens: 15,
      cost: { input: 0.001, output: 0.002, cacheRead: 0, cacheWrite: 0, total: 0.003 },
    },
    stopReason,
    timestamp: Date.now(),
  };
}

function finish(text = "Hello from native Pi RPC.", stopReason = "stop") {
  const message = assistant(text, stopReason);
  output({ type: "message_end", message });
  output({ type: "agent_end", messages: [message], willRetry: false });
  output({ type: "agent_settled" });
  activePrompt = null;
}

function prompt(request) {
  response(request);
  activePrompt = request;
  messageCount += 1;
  if (request.message.includes("remember")) memory = "durable-memory";
  persistState();
  output({ type: "agent_start" });
  output({
    type: "message_update",
    assistantMessageEvent: { type: "thinking_delta", contentIndex: 0, delta: "Inspecting " },
  });
  output({
    type: "message_update",
    assistantMessageEvent: {
      type: "text_delta",
      contentIndex: 1,
      delta: request.message.includes("recall") ? memory : "Hello ",
    },
  });
  if (request.message.includes("hang")) return;
  if (request.message.includes("tool")) {
    const envelope = Buffer.from(
      JSON.stringify({ toolCallId: "fake-tool-1", toolName: "write", input: { path: "fixture.txt", content: "ok" } }),
    ).toString("base64url");
    output({
      type: "extension_ui_request",
      id: "fake-ui-1",
      method: "confirm",
      title: "Allow Pi to use write?",
      message: `CADENCR_PERMISSION:${envelope}`,
    });
    return;
  }
  finish();
}

function extensionResponse(message) {
  if (message.id !== "fake-ui-1") return;
  output({ type: "tool_execution_start", toolCallId: "fake-tool-1", toolName: "write", args: { path: "fixture.txt", content: "ok" } });
  output({ type: "tool_execution_update", toolCallId: "fake-tool-1", toolName: "write", args: { path: "fixture.txt" }, partialResult: { content: [{ type: "text", text: "writing" }] } });
  output({ type: "tool_execution_end", toolCallId: "fake-tool-1", toolName: "write", result: { content: [{ type: "text", text: message.confirmed ? "written" : "blocked" }] }, isError: !message.confirmed });
  finish(message.confirmed ? "Tool completed." : "Tool denied.");
}

function handle(request) {
  if (request.type === "extension_ui_response") return extensionResponse(request);
  switch (request.type) {
    case "get_available_models":
      response(request, { models });
      break;
    case "get_state":
      response(request, state());
      break;
    case "get_available_thinking_levels":
      response(request, { levels: model.reasoning ? ["off", "minimal", "low", "medium", "high", "xhigh"] : ["off"] });
      break;
    case "get_commands":
      response(request, { commands: [{ name: "review", description: "Review changes", source: "skill" }] });
      break;
    case "set_model":
      model = models.find((entry) => entry.provider === request.provider && entry.id === request.modelId);
      if (!model) {
        output({ id: request.id, type: "response", command: request.type, success: false, error: "unknown model" });
      } else {
        thinkingLevel = model.reasoning ? "medium" : "off";
        persistState();
        response(request, model);
      }
      break;
    case "set_thinking_level":
      thinkingLevel = request.level;
      persistState();
      response(request);
      break;
    case "set_auto_compaction":
      autoCompactionEnabled = request.enabled;
      persistState();
      response(request);
      break;
    case "set_steering_mode":
      steeringMode = request.mode;
      persistState();
      response(request);
      break;
    case "set_follow_up_mode":
      followUpMode = request.mode;
      persistState();
      response(request);
      break;
    case "prompt":
      prompt(request);
      break;
    case "abort":
      response(request);
      if (activePrompt) finish("", "aborted");
      break;
    case "get_session_stats":
      response(request, { tokens: { input: 10, output: 5, cacheRead: 0, cacheWrite: 0, total: 15 }, cost: 0.003, contextUsage: { tokens: 10, contextWindow: model.contextWindow, percent: 1 } });
      break;
    default:
      output({ id: request.id, type: "response", command: request.type, success: false, error: `unsupported ${request.type}` });
  }
}

createInterface({ input: process.stdin, crlfDelay: Infinity }).on("line", (line) => {
  if (!line) return;
  handle(JSON.parse(line));
});
