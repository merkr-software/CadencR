node_modules/
out/
.vite/
.turbo/
dist/
# CodeGraph treats build/ as generated by default, but this directory contains
# first-party Electron packaging scripts that should remain indexed.
!packages/desktop/build/
*.log
.DS_Store
coverage/
packages/*/out/
packages/*/.vite/
packages/service/target/
target/
.shared-cargo-target/
*.db
*.db-shm
*.db-wal
# Content-addressed image store paired with local/custom SQLite databases.
*.db.blobs/
# Per-clone local environment and repo-local dev state. Never commit.
**/.env
**/.env.local
.cadencr/
.codegraph/
# Dev/CLI settings-store output: derived next to a repo-local dev DB.
packages/service/cadencr-settings/
# Same, for user-authored plugin content (themes today).
packages/service/plugins/
# Developer-created provider repositories live beside the dev settings dir.
packages/service/provider-workspaces/

# Local agent permissions and personal machine paths
.claude/settings.local.json
packages/*/dist-electron/
packages/*/release/
.superpowers/

.cursor
.idea
