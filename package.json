{
  "name": "cadencr",
  "private": true,
  "description": "A desktop IDE for AI coding agents — unified workspace for Claude Code, OpenCode, and more.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0 <23.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "start": "turbo run dev --filter=@cadencr/desktop",
    "build:local": "turbo run build:local --filter=@cadencr/desktop",
    "build": "turbo run build --filter=@cadencr/desktop",
    "prepare": "husky",
    "build:mac:signed": "pnpm --filter @cadencr/desktop build:mac:signed",
    "notarize:mac:status": "pnpm --filter @cadencr/desktop notarize:mac:status",
    "notarize:mac:staple": "pnpm --filter @cadencr/desktop notarize:mac:staple"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.46.0",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "@stoplight/spectral-functions": "1.10.2",
      "@stoplight/spectral-rulesets": "1.22.2",
      "volar-service-yaml": "0.0.71"
    }
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
