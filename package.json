{
  "name": "cadencr",
  "private": true,
  "description": "A desktop IDE for AI coding agents — unified workspace for Claude Code, OpenCode, and more.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0 <23.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:agents-md": "node scripts/build-agents-md.mjs",
    "test": "node scripts/cargo-env.mjs turbo run test && node --test scripts/*.test.mjs",
    "lint": "node scripts/cargo-env.mjs turbo run lint",
    "test:release-scripts": "env -u BASH_ENV bash scripts/update-homebrew-cask.test.sh && env -u BASH_ENV bash scripts/desktop-release-workflow.test.sh",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "start": "node scripts/dev.mjs --filter=@cadencr/desktop",
    "build:local": "node scripts/cargo-env.mjs turbo run build:local --filter=@cadencr/desktop",
    "build": "node scripts/cargo-env.mjs turbo run build --filter=@cadencr/desktop",
    "rust": "node scripts/cargo-env.mjs cargo",
    "rust:storage": "node scripts/rust-storage.mjs status",
    "rust:clean": "node scripts/rust-storage.mjs clean",
    "rust:prune": "node scripts/rust-storage.mjs prune",
    "prepare": "husky",
    "build:mac:signed": "pnpm --filter @cadencr/desktop build:mac:signed",
    "notarize:mac:status": "pnpm --filter @cadencr/desktop notarize:mac:status",
    "notarize:mac:staple": "pnpm --filter @cadencr/desktop notarize:mac:staple"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.56.0",
    "turbo": "^2.10.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
