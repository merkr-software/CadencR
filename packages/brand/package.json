{
  "name": "@cadencr/brand",
  "version": "0.15.1",
  "private": true,
  "description": "Cadencr brand source of truth — Index Dots geometry, Emerald Reserve tokens, and every generated icon and social asset in the repo.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "scripts": {
    "install:assets": "node scripts/install-assets.mjs",
    "check": "node scripts/install-assets.mjs --check",
    "readme:install": "node scripts/readme-assets.mjs",
    "readme:check": "node scripts/readme-assets.mjs --check",
    "lint": "oxlint src/ scripts/ test/",
    "lint:fix": "oxlint --fix src/ scripts/ test/",
    "format": "oxfmt src/ scripts/ test/",
    "format:check": "oxfmt --check src/ scripts/ test/",
    "test": "node --test test/*.test.mjs && node scripts/install-assets.mjs --check && node scripts/readme-assets.mjs --check",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.0"
  }
}
