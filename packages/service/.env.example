# Required for service dev. Copy to packages/service/.env and customize locally.
# CADENCR_FRONTEND_PORT should match packages/desktop/.env VITE_FRONTEND_PORT.
# CADENCR_AUTH_TOKEN should match packages/desktop/.env VITE_API_TOKEN.
# CADENCR_RUST_PORT should match the port used in packages/desktop/.env VITE_API_URL.

CADENCR_AUTH_TOKEN=replace-with-a-random-local-token
CADENCR_FRONTEND_PORT=1420
CADENCR_RUST_PORT=5005
CADENCR_DB_PATH=./cadencr.local.db

# Remote access serves the SPA from a built directory; Vite's in-memory dev
# server can't be used for it, so remote pairing needs a built renderer. Build
# it with `node ./scripts/electron-vite.mjs build` in packages/desktop. The
# remote device loads this bundle (no HMR) — rebuild after frontend changes.
CADENCR_RENDERER_DIR=../desktop/out/renderer

# Port for the remote-access TLS listener. Use 5007 in dev so it doesn't clash
# with a packaged Cadencr install, which defaults to 5006 (no env var there).
CADENCR_REMOTE_PORT=5007
