{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@desktop-shortcuts/*": ["../desktop/src/lib/shortcuts/*"]
    }
  },
  "include": [
    "src/**/*",
    ".astro/types.d.ts",
    "../desktop/src/lib/shortcuts/registry.ts"
  ],
  "exclude": ["dist", "design"]
}
