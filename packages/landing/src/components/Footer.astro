---
import LogoMark from "@/components/icons/LogoMark.astro";
import Wrap from "@/components/ui/Wrap.astro";
import { DISPLAY_VERSION } from "@/lib/app-version";
const base = import.meta.env.BASE_URL;
---
<footer class="border-t border-border/55 pb-11 pt-9">
  <Wrap>
    <div class="grid grid-cols-1 gap-7 sm:[grid-template-columns:1.2fr_3fr] sm:gap-14">
      <div class="flex flex-col gap-2.5">
        <span class="inline-flex items-center gap-2.5">
          <LogoMark size={36} />
          <span class="text-sm font-bold uppercase tracking-[0.14em]">Cadencr</span>
        </span>
        <span class="font-mono text-[11.5px] leading-[1.55] text-muted-foreground">
          The IDE for the era of agents.<br />
          Apache-2.0 · {DISPLAY_VERSION} · built in Paris.
        </span>
      </div>
      <div
        class="grid grid-cols-2 gap-6 sm:[grid-template-columns:repeat(3,minmax(120px,1fr))] [&_h3]:m-0 [&_h3]:mb-1 [&_h3]:font-mono [&_h3]:text-[10px] [&_h3]:font-medium [&_h3]:uppercase [&_h3]:tracking-[0.08em] [&_h3]:text-muted-foreground [&_a]:text-[12.5px] [&_a]:text-foreground/80 hover:[&_a]:text-foreground"
      >
        <div class="flex flex-col gap-2">
          <h3>Product</h3>
          <a href={`${base}#stream`}>Features</a>
          <a href={`${base}download/`}>Download</a>
          <a href={`${base}roadmap/`}>Roadmap</a>
          <a href={`${base}news/`}>News</a>
        </div>
        <div class="flex flex-col gap-2">
          <h3>Open source</h3>
          <a href="https://github.com/merkr-software/cadencr">GitHub</a>
          <a href="https://github.com/merkr-software/cadencr/discussions">Discussions</a>
          <a href="https://github.com/merkr-software/cadencr/issues">Issues</a>
          <a href="https://github.com/merkr-software/cadencr/blob/main/LICENSE">License</a>
        </div>
        <div class="flex flex-col gap-2">
          <h3>Community</h3>
          <a href={`${base}docs/`}>Docs</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </div>
      </div>
    </div>
    <div
      class="mt-7 flex flex-wrap gap-4 border-t border-border/55 pt-4.5 font-mono text-[10.5px] text-muted-foreground"
    >
      <span>Independent project, not affiliated with Anthropic, OpenAI, or SST.</span>
      <span class="flex-1"></span>
      <span>Apache-2.0</span>
    </div>
  </Wrap>
</footer>
