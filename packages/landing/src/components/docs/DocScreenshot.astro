---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /**
   * When the source image already includes its own framing/border (or a
   * window-chrome screenshot), pass `bordered={false}` so we don't draw a
   * second border on top.
   */
  bordered?: boolean;
  rounded?: boolean;
  elevated?: boolean;
  maxWidthClass?: string;
  /** Keep vector artwork and the full pixel detail of an already compressed UI capture. */
  preserveSource?: boolean;
}

const {
  src,
  alt,
  caption,
  bordered = true,
  rounded = bordered,
  elevated = false,
  maxWidthClass = "",
  preserveSource = false,
} = Astro.props;

const radiusClass = rounded ? "rounded-xl" : "";
const imageClass = [
  "block h-auto w-full",
  bordered ? "border border-border" : "",
  elevated ? "shadow-xl shadow-black/35" : bordered ? "shadow-md" : "",
  radiusClass,
]
  .filter(Boolean)
  .join(" ");
const figureClass = ["my-6", maxWidthClass].filter(Boolean).join(" ");
const widths = [720, 1200, 1600].filter((width) => width <= src.width);
if (widths.length === 0) widths.push(src.width);
---
<figure class={figureClass}>
  <a
    href={src.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Open full-size screenshot: ${alt}`}
    class="block cursor-zoom-in"
    data-doc-screenshot
  >
    {
      preserveSource ? (
        <img
          src={src.src}
          alt={alt}
          width={src.width}
          height={src.height}
          loading="lazy"
          decoding="async"
          class={imageClass}
        />
      ) : (
        <Image
          src={src}
          alt={alt}
          width={Math.max(...widths)}
          widths={widths}
          sizes="(min-width: 768px) 720px, 100vw"
          format="webp"
          quality={95}
          loading="lazy"
          decoding="async"
          class={imageClass}
        />
      )
    }
  </a>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-muted-foreground">{caption}</figcaption>
  )}
</figure>
