---
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import CodeIcon from "@/components/icons/CodeIcon.astro";
import Button from "@/components/ui/Button.astro";
import Wrap from "@/components/ui/Wrap.astro";
import { DISPLAY_VERSION } from "@/lib/downloads";
import { getCollection, type CollectionEntry } from "astro:content";
import HeroCapture from "@/components/HeroCapture.astro";

const base = import.meta.env.BASE_URL;
// Fully-qualified tap form so it works without a separate `brew tap` step.
const brewCommand = "brew install --cask merkr-software/cadencr/cadencr";

// The five surfaces CadencR unifies — a quiet strip under the headline,
// each linking to the section that shows it.
const surfaces = [
  { label: "Agent", anchor: "agent-cockpit" },
  { label: "Git", anchor: "git" },
  { label: "Browser", anchor: "browser" },
  { label: "Editor", anchor: "editor" },
  { label: "Terminal", anchor: "terminal" },
];

// Newest news post, if any — a quiet wash pill below the CTAs. Sorted
// newest-first, matching the News index page.
type NewsEntry = CollectionEntry<"news">;
const [latestNews] = (await getCollection("news")).sort(
  (a: NewsEntry, b: NewsEntry) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<section class="hero relative pt-14 sm:pt-20">
  <!-- The one emerald top-light on the page (Jewel-Light Rule: ≤4% alpha). -->
  <div class="jewel-light pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px]" aria-hidden="true"></div>
  <Wrap>
    <div class="mx-auto flex max-w-[860px] flex-col items-center text-center">
      <p class="hero-rise fig-label">
        <span class="fig-no">Desktop IDE</span>
        <span aria-hidden="true">·</span>
        <span>macOS</span>
        <span aria-hidden="true">·</span>
        <span>{DISPLAY_VERSION}</span>
      </p>

      <h1 class="hero-rise hero-rise-1 type-display mt-6 text-[clamp(38px,6.6vw,72px)] [text-wrap:balance]">
        Stop switching.<br />
        Every agent, <span class="whitespace-nowrap text-primary">one window.</span>
      </h1>

      <p
        class="hero-rise hero-rise-2 mt-6 max-w-[58ch] text-[16px] leading-[1.65] text-muted-foreground [text-wrap:pretty] [&_.em]:font-medium [&_.em]:text-foreground"
      >
        CadencR is the desktop workspace around the agent CLIs you already run:
        <span class="em">bring your own Claude Code, OpenCode, or Codex</span>
        and read, steer, and ship from one place, with your whole dev environment in view.
      </p>

      <div class="hero-rise hero-rise-3 mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href={`${base}download/`} size="lg" class="h-11 gap-2.5 px-5 text-sm">
          <DownloadIcon />
          Download for Mac
        </Button>
        <Button
          href="https://github.com/merkr-software/cadencr"
          variant="outline"
          size="lg"
          class="h-11 gap-2.5 px-5 text-sm"
        >
          <CodeIcon />
          Source on GitHub
        </Button>
      </div>

      <div class="hero-rise hero-rise-3 mt-4 flex items-center gap-2 text-[13px] text-muted-foreground">
        <span>or</span>
        <button
          type="button"
          class="hero-brew group inline-flex items-center gap-2 rounded-lg bg-accent/70 px-3 py-1.5 font-mono text-[12.5px] text-foreground transition-colors hover:bg-accent"
          data-copy={brewCommand}
          aria-label={`Copy: ${brewCommand}`}
        >
          <span class="select-all">{brewCommand}</span>
          <svg class="hero-brew-copy h-3.5 w-3.5 text-muted-foreground transition-colors group-hover:text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg class="hero-brew-check hidden h-3.5 w-3.5 text-drac-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>

      {
        latestNews && (
          <a
            href={`${base}news/${latestNews.id}/`}
            class="hero-rise hero-rise-4 group mt-7 inline-flex max-w-full items-center gap-2.5 rounded-full bg-accent/70 py-1.5 pl-1.5 pr-4 text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            <span class="inline-flex items-center rounded-full bg-primary px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-primary-foreground">
              New
            </span>
            <span class="truncate">{latestNews.data.title}</span>
            <span
              class="text-primary transition-transform group-hover:translate-x-0.5"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        )
      }
    </div>
  </Wrap>

  <!-- The five unified surfaces — a quiet centered strip, no rules. -->
  <div class="hero-rise hero-rise-4 mt-12">
    <Wrap>
      <ul class="flex flex-wrap items-center justify-center gap-2.5" role="list">
        {surfaces.map((s, i) => (
          <li>
            <a href={`${base}#${s.anchor}`} class="surface-chip">
              <span class="font-mono text-[11px] text-primary" aria-hidden="true">
                0{i + 1}
              </span>
              <span class="text-[13.5px] font-medium">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </Wrap>
  </div>

  <Wrap class="py-12 sm:py-16">
    <div class="hero-rise hero-rise-5">
      <HeroCapture />
    </div>
  </Wrap>
</section>

<script>
  // Copy the brew command to the clipboard with visible success/failure feedback.
  const btn = document.querySelector<HTMLButtonElement>(".hero-brew");
  if (btn) {
    const copyIcon = btn.querySelector<SVGElement>(".hero-brew-copy");
    const checkIcon = btn.querySelector<SVGElement>(".hero-brew-check");
    const command = btn.dataset.copy ?? "";
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    const flash = (ok: boolean): void => {
      if (resetTimer) clearTimeout(resetTimer);
      if (ok) {
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        resetTimer = setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
        }, 1600);
      } else {
        // Surface the failure rather than swallowing it silently.
        btn.setAttribute("title", "Couldn't copy: select the text and copy manually");
        btn.classList.add("hero-brew-error");
        resetTimer = setTimeout(() => {
          btn.removeAttribute("title");
          btn.classList.remove("hero-brew-error");
        }, 2200);
      }
    };

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command);
        flash(true);
      } catch {
        flash(false);
      }
    });
  }
</script>

<style>
  /* Surface chips — machined pills for the five unified surfaces. A soft
     wash with an inset top highlight at rest; hover warms the wash and
     rims the pill with a faint emerald light. */
  .surface-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    padding: 9px 16px 9px 13px;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--color-foreground) 4.5%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--color-foreground) 5%, transparent),
      var(--shadow-xs);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .surface-chip:hover {
    background: var(--color-accent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--color-foreground) 7%, transparent),
      0 0 0 1px color-mix(in oklch, var(--color-primary) 28%, transparent),
      0 4px 18px -4px color-mix(in oklch, var(--color-primary) 20%, transparent);
  }
  .surface-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .hero-brew-error {
    box-shadow: inset 0 0 0 1px var(--color-destructive);
    color: var(--color-destructive);
  }

  /* Staggered entrance: one quiet rise-and-settle sequence. */
  .hero-rise {
    animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-rise-1 {
    animation-delay: 0.06s;
  }
  .hero-rise-2 {
    animation-delay: 0.12s;
  }
  .hero-rise-3 {
    animation-delay: 0.18s;
  }
  .hero-rise-4 {
    animation-delay: 0.24s;
  }
  .hero-rise-5 {
    animation-delay: 0.3s;
    animation-duration: 0.9s;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
    }
  }
</style>
