---
import FeatureSection from "@/components/FeatureSection.astro";
import FeatureMedia from "@/components/ui/FeatureMedia.astro";
import Lede from "@/components/ui/Lede.astro";
import sideBySide from "@/assets/side-by-side.png";
---
<FeatureSection
  id="stream"
  eyebrow="Stream"
  heading="Your harness — finally readable."
>
  <FeatureMedia
    slot="media"
    src={sideBySide}
    alt="Side-by-side: raw harness terminal output on the left, CadencR's rendered stream on the right"
    bordered
    shadow
  />
  <Fragment slot="lede">
    <Lede>
      Raw terminal output buries every signal under
      <span class="em">bash, grep, cat, head</span>.
      CadencR reinterprets the stream as it arrives. Tool calls become pills. File writes become inline diffs. Long outputs collapse until you ask for them.
    </Lede>
    <Lede class="mt-2.5">
      Same agent. Same commands. Orders of magnitude more legible.
    </Lede>
  </Fragment>
  <Fragment slot="bullets">
    <li><strong>Inline diffs</strong> — themed syntax, +/- gutters, not walls of unified patch.</li>
    <li><strong>Tool-call pills</strong> — Bash, Grep, Read, Edit, Thinking. Click to expand.</li>
    <li><strong>Per-message model tag</strong> — never guess which agent said what.</li>
    <li><strong>Context meter</strong> in the status bar so you see the window filling.</li>
  </Fragment>
</FeatureSection>
