---
import FeatureSection from "@/components/FeatureSection.astro";
import FeatureMedia from "@/components/ui/FeatureMedia.astro";
import Lede from "@/components/ui/Lede.astro";
import gitImage from "@/assets/git.png";
---
<FeatureSection
  id="git"
  eyebrow="Git"
  heading="Git stays where you can see it."
>
  <FeatureMedia
    slot="media"
    src={gitImage}
    alt="CadencR git panel showing staged diffs, pending commits, and working changes alongside the code editor and agent stream"
  />
  <Fragment slot="lede">
    <Lede>
      Agents don't edit in place — they land commits. CadencR shows the staged diff and the pending message
      <span class="em">before</span> anything ships. You review, edit the message, commit.
    </Lede>
  </Fragment>
  <Fragment slot="bullets">
    <li><strong>Per-session branch</strong> with auto-generated names you can rename.</li>
    <li><strong>Commit previews</strong> before every tool-group lands.</li>
    <li><strong>Stash &amp; checkout</strong> from the keyboard, no terminal detour.</li>
    <li><strong>Graph view</strong> of sessions × branches.</li>
  </Fragment>
</FeatureSection>
