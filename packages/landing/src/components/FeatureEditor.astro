---
import FeatureSection from "@/components/FeatureSection.astro";
import FeatureMedia from "@/components/ui/FeatureMedia.astro";
import Lede from "@/components/ui/Lede.astro";
import editorImage from "@/assets/editor.png";
---
<FeatureSection
  id="editor"
  eyebrow="Editor"
  heading="A real editor — not a viewer."
>
  <FeatureMedia
    slot="media"
    src={editorImage}
    alt="CadencR editor showing the file tree, an open file, and the agent commit summary panel on the right"
  />
  <Fragment slot="lede">
    <Lede>
      Open any file the agent touched and
      <span class="em">edit it on the spot</span>
      — no jumping to another app to fix a typo, tweak a prompt, or unwind a chunk.
    </Lede>
  </Fragment>
  <Fragment slot="bullets">
    <li><strong>Quick open</strong> — jump to any file in the worktree instantly.</li>
    <li><strong>Inline diffs</strong> — accept, revert, or rewrite chunks without leaving the file.</li>
    <li><strong>File tree</strong> — browse the full worktree without leaving the session.</li>
  </Fragment>
</FeatureSection>
