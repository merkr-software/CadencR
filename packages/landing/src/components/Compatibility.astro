---
import { Image } from "astro:assets";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Lede from "@/components/ui/Lede.astro";
import claudeLogo from "@/assets/providers/claude.png";
import codexLogo from "@/assets/providers/codex.png";
import cursorLogo from "@/assets/providers/cursor.png";
import opencodeLogo from "@/assets/providers/opencode.png";
import type { ImageMetadata } from "astro";

interface Provider {
  name: string;
  logo: ImageMetadata;
  logoClass: string;
}

const providers: Provider[] = [
  { name: "Claude Code", logo: claudeLogo, logoClass: "h-7 w-7" },
  { name: "OpenCode", logo: opencodeLogo, logoClass: "h-7 w-[22px]" },
  { name: "Codex", logo: codexLogo, logoClass: "h-7 w-7" },
  { name: "Cursor", logo: cursorLogo, logoClass: "h-7 w-7" },
];
---
<section id="compat" class="relative scroll-mt-16 py-14 sm:py-16">
  <Wrap>
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] md:gap-14">
      <div class="reveal">
        <Eyebrow index="01">Compatibility</Eyebrow>
        <SectionHeading>Works with the agents you already run.</SectionHeading>
        <Lede>
          CadencR is <span class="em">provider-neutral by design</span>: it is the IDE surface
          for the agent CLIs on your machine, not another vendor's chat. Bring your own keys.
          No lock-in or agent proxy. Diagnostics and detailed analytics require your choice;
          the separate monthly installation counter can also be disabled.
        </Lede>
      </div>

      <ul class="reveal reveal-late grid grid-cols-2 gap-2.5 max-w-[440px] md:ml-auto md:w-full" role="list">
        {providers.map((provider) => (
          <li class="soft-panel flex flex-col items-center justify-center gap-3 px-4 py-6">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-sidebar shadow-xs">
              <Image
                src={provider.logo}
                alt=""
                width={56}
                height={56}
                class:list={["object-contain", provider.logoClass]}
              />
            </span>
            <span class="text-[14.5px] font-semibold tracking-[-0.005em]">{provider.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </Wrap>
</section>
