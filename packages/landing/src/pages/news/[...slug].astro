---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lede from "@/components/ui/Lede.astro";
import { formatDate } from "@/lib/formatDate";
import { SITE_URL, ORG_REF } from "@/lib/seo";

type NewsEntry = CollectionEntry<"news">;

export async function getStaticPaths() {
  const entries: NewsEntry[] = await getCollection("news");
  return entries.map((entry: NewsEntry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: NewsEntry;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = new URL(`news/${entry.id}/`, Astro.site).toString();
const ogImage = new URL("og-image.png", Astro.site).toString();
const published = entry.data.date.toISOString();
const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: published,
  dateModified: published,
  author: { "@type": "Person", name: entry.data.author },
  publisher: ORG_REF,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  image: ogImage,
  url: canonical,
  inLanguage: "en",
  keywords: entry.data.tags.join(", "),
  isPartOf: { "@type": "Blog", "@id": `${SITE_URL}/news/#blog`, name: "CadencR news" },
};
const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "News", item: `${SITE_URL}/news/` },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: canonical },
  ],
};
const structuredData = [blogPosting, breadcrumbs];
---
<BaseLayout
  title={`${entry.data.title} — CadencR`}
  description={entry.data.summary}
  ogType="article"
  article={{ publishedTime: published, modifiedTime: published, author: entry.data.author }}
  structuredData={structuredData}
>
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-8 max-w-[680px]">
        <Eyebrow>{formatDate(entry.data.date)} · {entry.data.author}</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(26px,3vw,34px)] font-semibold leading-[1.18] tracking-[-0.018em] [text-wrap:balance]">
          {entry.data.title}
        </h1>
        <Lede>{entry.data.summary}</Lede>
      </div>
      <article class="prose">
        <Content />
      </article>
    </Wrap>
  </section>
</BaseLayout>
