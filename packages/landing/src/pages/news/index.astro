---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lede from "@/components/ui/Lede.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { formatDate } from "@/lib/formatDate";

type NewsEntry = CollectionEntry<"news">;
const entries: NewsEntry[] = (await getCollection("news")).sort(
  (a: NewsEntry, b: NewsEntry) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...rest] = entries;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="News — Cadencr" description="Release notes, articles and announcements for Cadencr.">
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-10 max-w-[680px]">
        <Eyebrow>News</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(26px,3vw,34px)] font-semibold leading-[1.18] tracking-[-0.018em] [text-wrap:balance]">
          What we shipped, what we're thinking.
        </h1>
        <Lede>
          Release notes, deep dives and short announcements. Subscribe via the
          <a href={`${base}rss.xml`} class="text-drac-purple hover:underline">RSS feed</a>.
        </Lede>
      </div>

      {entries.length === 0 ? (
        <EmptyState lead="No posts yet.">
          {" "}The first article will land with v1.0 — the redesigned stream renderer and release notes.
        </EmptyState>
      ) : (
        <div class="flex flex-col gap-10">
          <a
            href={`${base}news/${featured.id}/`}
            class="group relative flex flex-col gap-4 overflow-hidden rounded-xl border border-border bg-muted/20 p-7 transition-colors duration-150 hover:border-primary/50 sm:p-10"
          >
            <span class="absolute right-5 top-5 inline-flex items-center rounded-full border border-primary/40 bg-primary/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em] text-primary">
              Latest
            </span>
            <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted-foreground">
              {formatDate(featured.data.date)} · {featured.data.author}
            </span>
            <h2 class="max-w-[760px] text-[clamp(22px,2.4vw,30px)] font-semibold leading-[1.2] tracking-[-0.015em] [text-wrap:balance] group-hover:text-primary">
              {featured.data.title}
            </h2>
            <p class="max-w-[680px] text-[14.5px] leading-[1.6] text-muted-foreground [text-wrap:pretty]">
              {featured.data.summary}
            </p>
            <span class="mt-1 inline-flex items-center gap-1.5 text-[12.5px] font-medium text-drac-purple">
              Read the article
              <span aria-hidden="true">→</span>
            </span>
          </a>

          {rest.length > 0 && (
            <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
              {rest.map((entry: NewsEntry) => (
                <a
                  href={`${base}news/${entry.id}/`}
                  class="flex flex-col gap-2 rounded-lg border border-border bg-muted/20 p-5 transition-colors duration-150 hover:border-primary/40"
                >
                  <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted-foreground">
                    {formatDate(entry.data.date)}
                  </span>
                  <span class="text-[15.5px] font-semibold tracking-[-0.005em]">{entry.data.title}</span>
                  <span class="text-[13px] leading-[1.5] text-muted-foreground">{entry.data.summary}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      )}
    </Wrap>
  </section>
</BaseLayout>
