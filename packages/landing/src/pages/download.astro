---
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  DISPLAY_VERSION,
  DOWNLOAD_ASSETS,
  LATEST_RELEASE_URL,
  selectRecommendedDownload,
} from "@/lib/downloads";
import { SITE_URL, ORG_REF } from "@/lib/seo";

const defaultDownload = selectRecommendedDownload({ os: "macos", arch: "unknown" });
const pageTitle = "Download CadencR for macOS — agent IDE for Claude Code, OpenCode, and Codex";
const pageDescription =
  "Download the latest CadencR desktop build for macOS. CadencR is the local IDE for supervising Claude Code, OpenCode, and Codex agent sessions.";

const softwareApplication = {
  "@type": "SoftwareApplication",
  "@id": `${SITE_URL}/#software`,
  name: "CadencR",
  alternateName: ["Cadencr", "Cadencr IDE"],
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "IDE",
  operatingSystem: "macOS",
  softwareVersion: DISPLAY_VERSION,
  description: pageDescription,
  downloadUrl: defaultDownload?.url ?? LATEST_RELEASE_URL,
  installUrl: `${SITE_URL}/download/`,
  isAccessibleForFree: true,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  author: ORG_REF,
  publisher: ORG_REF,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: `${SITE_URL}/download/`,
};
const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Download", item: `${SITE_URL}/download/` },
  ],
};
const structuredData = [softwareApplication, breadcrumbs];
---
<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <section class="py-16">
    <div class="mx-auto grid max-w-[1160px] grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.12em] text-primary">
          Download · {DISPLAY_VERSION}
        </p>
        <h1 class="mt-3 text-[clamp(30px,4vw,52px)] font-semibold leading-[1.05] tracking-[-0.025em] [text-wrap:balance]">
          Get CadencR for your machine.
        </h1>
        <p class="mt-4 max-w-[620px] text-sm leading-[1.65] text-muted-foreground [text-wrap:pretty]">
          CadencR currently ships for macOS. We try to detect the right build automatically,
          and you can always choose another target manually below.
        </p>
      </div>

      <section
        aria-labelledby="recommended-download-title"
        class="rounded-2xl bg-sidebar p-6 shadow-md"
        data-download-card
      >
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.12em] text-muted-foreground">
          Recommended build
        </p>
        <h2 id="recommended-download-title" class="mt-2 text-2xl font-semibold tracking-[-0.018em]">
          <span data-download-title>{defaultDownload?.label ?? "Choose your download"}</span>
        </h2>
        <p class="mt-2 min-h-[44px] text-[13.5px] leading-[1.6] text-muted-foreground" data-download-copy>
          {defaultDownload
            ? "Defaults to Apple Silicon — the right build for every Mac since 2020. On an Intel Mac, pick the Intel target below."
            : "We could not determine a shipped build for this device yet."}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a
            href={defaultDownload?.url ?? LATEST_RELEASE_URL}
            class="inline-flex h-10 items-center gap-2 rounded-lg border border-transparent bg-primary px-4 text-[13px] font-medium text-primary-foreground transition-colors hover:bg-primary/90 [&_svg]:h-[14px] [&_svg]:w-[14px] [&_svg]:shrink-0 [&_svg]:stroke-[2]"
            data-download-primary
          >
            <DownloadIcon />
            <span data-download-button-label>Download for macOS</span>
          </a>
          <a
            href={LATEST_RELEASE_URL}
            class="inline-flex h-10 items-center gap-2 rounded-lg bg-accent/70 px-4 text-[13px] font-medium transition-colors hover:bg-accent [&_svg]:h-[14px] [&_svg]:w-[14px] [&_svg]:shrink-0 [&_svg]:stroke-[2]"
          >
            <GithubIcon />
            View GitHub release
          </a>
        </div>
        <p class="mt-4 font-mono text-[11px] text-muted-foreground" data-download-detection>
          Detecting your platform in the browser…
        </p>
      </section>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto grid max-w-[1160px] grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_0.85fr]">
      <div>
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.12em] text-primary">
              Manual targets
            </p>
            <h2 class="mt-2 text-[26px] font-semibold tracking-[-0.018em]">Choose a build</h2>
          </div>
        </div>
        <div class="grid gap-3">
          {DOWNLOAD_ASSETS.map((asset) => (
            <a
              id={asset.href.slice(1)}
              href={asset.url}
              class="group soft-panel grid gap-3 p-4 transition-colors hover:bg-accent sm:grid-cols-[1fr_auto] sm:items-center"
              data-download-asset={asset.assetName}
            >
              <span>
                <span class="block text-sm font-medium">{asset.label}</span>
                <span class="mt-1 block font-mono text-[11px] text-muted-foreground">{asset.assetName}</span>
              </span>
              <span class="inline-flex items-center gap-2 whitespace-nowrap font-mono text-[11px] text-muted-foreground group-hover:text-foreground [&_svg]:h-[14px] [&_svg]:w-[14px] [&_svg]:shrink-0">
                {asset.size}
                <DownloadIcon />
              </span>
            </a>
          ))}
        </div>
      </div>

      <aside class="self-start rounded-2xl bg-sidebar p-6 shadow-md">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.12em] text-primary">
          Coming next
        </p>
        <h2 class="mt-2 text-[24px] font-semibold tracking-[-0.018em]">
          Linux and Windows builds are coming next.
        </h2>
        <p class="mt-3 text-[13.5px] leading-[1.65] text-muted-foreground">
          The app already runs as an Electron desktop shell with a Rust sidecar. The next
          distribution work is predictable packaging, update behavior, and installer flows
          for Linux and Windows.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>



<script
  is:inline
  id="download-assets-json"
  type="application/json"
  set:html={JSON.stringify(DOWNLOAD_ASSETS)}
></script>
<script>
  import { archFromRenderer, normalizeArch, preferredMacArch, resolveMacArch } from "@/lib/downloads";
  import type { DetectedArch, DetectedOs } from "@/lib/downloads";

  interface BrowserDownloadAsset {
    arch: DetectedArch;
    label: string;
    os: "macos";
    url: string;
  }
  interface NavigatorUserAgentData {
    architecture?: string;
    platform?: string;
    getHighEntropyValues?: (hints: string[]) => Promise<NavigatorUserAgentData>;
  }
  interface NavigatorWithUserAgentData extends Navigator {
    userAgentData?: NavigatorUserAgentData;
  }

  const downloadsText = document.querySelector<HTMLScriptElement>("#download-assets-json")?.textContent ?? "[]";
  const downloads = JSON.parse(downloadsText) as BrowserDownloadAsset[];

  function detectOs(platform: string, userAgent: string): DetectedOs {
    const value = `${platform} ${userAgent}`.toLowerCase();
    if (value.includes("mac")) return "macos";
    if (value.includes("win")) return "windows";
    if (value.includes("linux")) return "linux";
    return "unknown";
  }

  function browserPlatform(): string {
    const nav = navigator as NavigatorWithUserAgentData;
    return nav.userAgentData?.platform ?? "";
  }

  // The GPU renderer string is the only arch signal Safari and Firefox expose.
  // Reading it needs a throwaway WebGL context + the debug-renderer extension,
  // both of which can be unavailable (WebGL disabled, Lockdown Mode) — any
  // failure just yields "" and we fall back to the other signals.
  function gpuRenderer(): string {
    try {
      const canvas = document.createElement("canvas");
      const gl = canvas.getContext("webgl") ?? canvas.getContext("experimental-webgl");
      if (!(gl instanceof WebGLRenderingContext)) return "";
      const info = gl.getExtension("WEBGL_debug_renderer_info");
      if (!info) return "";
      const renderer = gl.getParameter(info.UNMASKED_RENDERER_WEBGL);
      // Free the GPU-driver-backed context immediately; we only needed one read.
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return typeof renderer === "string" ? renderer : "";
    } catch {
      return "";
    }
  }

  async function archFromUserAgentData(): Promise<DetectedArch> {
    const nav = navigator as NavigatorWithUserAgentData;
    if (nav.userAgentData?.getHighEntropyValues) {
      const highEntropy = await nav.userAgentData.getHighEntropyValues(["architecture"]);
      return normalizeArch(highEntropy.architecture ?? "");
    }
    return "unknown";
  }

  async function detectArchitecture(): Promise<DetectedArch> {
    // The GPU renderer reflects the physical machine and survives Rosetta, so
    // when it's definitive skip the userAgentData round-trip entirely.
    const renderer = archFromRenderer(gpuRenderer());
    if (renderer !== "unknown") return renderer;
    return resolveMacArch({ renderer, userAgentData: await archFromUserAgentData() });
  }

  function chooseDownload(os: DetectedOs, arch: DetectedArch): BrowserDownloadAsset | undefined {
    if (os !== "macos") return undefined;
    const wanted = preferredMacArch(arch);
    return downloads.find((asset) => asset.arch === wanted);
  }

  function describeDetection(os: DetectedOs, arch: DetectedArch): string {
    if (os === "macos") return `Detected macOS${arch === "unknown" ? "" : ` (${arch})`}.`;
    if (os === "linux") return "Detected Linux. Native Linux builds are planned next.";
    if (os === "windows") return "Detected Windows. Native Windows builds are planned next.";
    return "Could not determine your operating system. Choose a target manually below.";
  }

  async function updateRecommendedDownload(): Promise<void> {
    const os = detectOs(browserPlatform(), navigator.userAgent);
    const arch = await detectArchitecture();
    const recommendation = chooseDownload(os, arch);
    const title = document.querySelector<HTMLElement>("[data-download-title]");
    const copy = document.querySelector<HTMLElement>("[data-download-copy]");
    const primary = document.querySelector<HTMLAnchorElement>("[data-download-primary]");
    const label = document.querySelector<HTMLElement>("[data-download-button-label]");
    const detection = document.querySelector<HTMLElement>("[data-download-detection]");

    if (detection) detection.textContent = describeDetection(os, arch);
    if (!recommendation) {
      if (title) title.textContent = os === "unknown" ? "Choose your build" : "Coming soon for your OS";
      if (copy) {
        copy.textContent = "CadencR currently ships for macOS. Linux and Windows builds are planned next.";
      }
      if (label) label.textContent = "View available downloads";
      if (primary) primary.href = "#macos-arm64-dmg";
      return;
    }

    if (title) title.textContent = recommendation.label;
    if (copy) {
      copy.textContent = "Recommended for this browser. You can still choose another macOS target below.";
    }
    if (label) label.textContent = `Download ${recommendation.label.replace("macOS ", "")}`;
    if (primary) primary.href = recommendation.url;
  }

  void updateRecommendedDownload();
</script>
