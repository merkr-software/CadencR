---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrap from "@/components/ui/Wrap.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import DocsToc from "@/components/docs/DocsToc.astro";
import { DOC_SECTIONS } from "@/lib/docs";

interface DocFrontmatter {
  title?: string;
  description?: string;
}

interface Props {
  /**
   * MDX files using `layout: "@/layouts/DocLayout.astro"` pass their
   * frontmatter under `Astro.props.frontmatter` (Astro convention).
   * The old top-level `title` / `description` props were never set,
   * which is why every doc page emitted `<title>undefined — CadencR</title>`.
   */
  frontmatter?: DocFrontmatter;
  title?: string;
  description?: string;
}

const { frontmatter, title: titleProp, description: descriptionProp } = Astro.props;

/**
 * Derive the page slug from the current URL and look up the matching
 * sidebar label. The visible H1 always mirrors what the reader clicked
 * in the sidebar, even when the SEO/frontmatter `title` is longer
 * (e.g. "The IDE for the era of agents" vs sidebar "Concept").
 */
function slugFromPath(pathname: string): string {
  const match = pathname.match(/\/docs\/?([^/]*)\/?$/);
  return match ? match[1] : "";
}

const slug = slugFromPath(Astro.url.pathname);
const docPage = DOC_SECTIONS.flatMap((s) => s.pages).find((p) => p.slug === slug);

const title = frontmatter?.title ?? titleProp ?? docPage?.title ?? "Docs";
const description = frontmatter?.description ?? descriptionProp ?? docPage?.description;
const navLabel = docPage?.navLabel ?? title;

const breadcrumbs = [
  { name: "Home", url: "https://cadencr.com/" },
  { name: "Docs", url: "https://cadencr.com/docs/" },
];
if (slug.length > 0) {
  breadcrumbs.push({
    name: navLabel,
    url: `https://cadencr.com/docs/${slug}/`,
  });
}
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};
---
<BaseLayout
  title={`${title} — CadencR`}
  description={description}
  structuredData={structuredData}
>
  <section class="py-10 pb-24">
    <Wrap>
      <div class="mb-8 max-w-[760px]">
        <h1 class="mt-0 mb-3 text-[clamp(28px,3vw,38px)] font-semibold leading-[1.12] tracking-[-0.018em] [text-wrap:balance]">
          {navLabel}
        </h1>
        {description && <p class="max-w-[680px] text-sm text-muted-foreground">{description}</p>}
      </div>
      <div class="grid gap-8 xl:grid-cols-[220px_minmax(0,720px)] 2xl:grid-cols-[220px_minmax(0,720px)_220px]">
        <DocsSidebar currentPath={Astro.url.pathname} />
        <article class="prose js-doc-content min-w-0">
          <slot />
        </article>
        <DocsToc />
      </div>
    </Wrap>
  </section>
</BaseLayout>
