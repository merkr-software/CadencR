---
import "@/styles/global.css";
import NavBar from "@/components/NavBar.astro";
import Footer from "@/components/Footer.astro";

type StructuredData = Record<string, unknown> | Array<Record<string, unknown>>;

interface Props {
  title?: string;
  description?: string;
  structuredData?: StructuredData;
}
const {
  title = "Cadencr — IDE for the era of agents",
  description = "Cadencr is the IDE for the era of agents. One workspace for Claude, OpenCode and Codex — readable stream, worktrees, and visible git.",
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("og-image.png", Astro.site).toString();
const rssUrl = new URL("rss.xml", Astro.site).toString();
const structuredDataJson = structuredData ? JSON.stringify(structuredData) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Cadencr news" href={rssUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Cadencr — The IDE for the era of agents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Cadencr — The IDE for the era of agents." />
    <meta name="color-scheme" content="dark" />
    {structuredDataJson && (
      <script type="application/ld+json" set:html={structuredDataJson} />
    )}
  </head>
  <body>
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
