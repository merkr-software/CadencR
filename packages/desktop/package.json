{
  "name": "@cadencr/desktop",
  "private": true,
  "version": "0.3.1",
  "description": "Cadencr desktop shell — Electron app with a React frontend for driving local AI coding agents.",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:electron": "electron-vite dev",
    "build:local": "electron-vite build && electron-builder --config electron-builder.local.yml",
    "build": "pnpm --filter @cadencr/service build && electron-vite build && electron-builder --config electron-builder.yml",
    "build:electron": "pnpm --filter @cadencr/service build && electron-vite build && electron-builder --config electron-builder.yml",
    "package:electron": "electron-builder --config electron-builder.yml",
    "lint": "oxlint src/ electron/",
    "lint:fix": "oxlint --fix src/ electron/",
    "format": "oxfmt src/ electron/",
    "format:check": "oxfmt --check src/ electron/",
    "test": "vitest run",
    "ts-check": "tsc --noEmit",
    "knip": "knip",
    "generate:openapi": "cargo run --quiet --manifest-path ../service/Cargo.toml --bin dump-openapi",
    "generate:api": "pnpm generate:openapi && orval --config ./orval.config.ts && oxfmt src/api/generated/",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "predev": "pnpm ensure:electron",
    "predev:electron": "pnpm ensure:electron",
    "prebuild:local": "pnpm ensure:electron",
    "prebuild": "pnpm ensure:electron",
    "prebuild:electron": "pnpm ensure:electron",
    "build:mac:signed": "node scripts/build-mac-signed.mjs",
    "notarize:mac:status": "node scripts/notarize-status.mjs",
    "notarize:mac:staple": "node scripts/notarize-staple.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/lsp-client": "^6.2.4",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@lexical/react": "^0.42.0",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.1.22",
    "@pierre/trees": "1.0.0-beta.4",
    "@react-symbols/icons": "^1.3.1",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/hotkeys": "0.8.0",
    "@tanstack/query-sync-storage-persister": "^4.43.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^4.43.0",
    "@tanstack/react-query-persist-client": "^4.43.0",
    "@tanstack/react-router": "1.170.0",
    "@tanstack/router-vite-plugin": "1.167.0",
    "@uiw/codemirror-themes": "^4.25.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "axios": "1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.3.9",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.2",
    "lexical": "^0.42.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.6",
    "react-virtuoso": "^4.18.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "^10.4.24",
    "electron": "42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "29.1.1",
    "knip": "^6.3.0",
    "msw": "^2",
    "orval": "7.21.0",
    "oxlint": "^1.46.0",
    "postcss": "8.5.14",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "6.4.2",
    "vitest": "4.1.6"
  }
}
