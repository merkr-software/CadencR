{
  "name": "@cadencr/desktop",
  "private": true,
  "version": "0.10.0",
  "description": "Cadencr desktop shell — Electron app with a React frontend for driving local AI coding agents.",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/electron-vite.mjs dev",
    "dev:electron": "node ./scripts/electron-vite.mjs dev",
    "build:local": "node ./scripts/electron-vite.mjs build && electron-builder --config electron-builder.local.yml",
    "build": "pnpm --filter @cadencr/service build && node ./scripts/electron-vite.mjs build && electron-builder --config electron-builder.yml",
    "build:electron": "pnpm --filter @cadencr/service build && node ./scripts/electron-vite.mjs build && electron-builder --config electron-builder.yml",
    "package:electron": "electron-builder --config electron-builder.yml",
    "lint": "oxlint src/ electron/",
    "lint:fix": "oxlint --fix src/ electron/",
    "format": "oxfmt src/ electron/",
    "format:check": "oxfmt --check src/ electron/",
    "test": "vitest run",
    "ts-check": "tsc --noEmit",
    "knip": "knip",
    "generate:openapi": "node ../../scripts/cargo-env.mjs cargo run --quiet --manifest-path ../service/Cargo.toml --bin dump-openapi",
    "generate:api": "pnpm generate:openapi && orval --config ./orval.config.ts && oxfmt src/api/generated/",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "predev": "pnpm ensure:electron",
    "predev:electron": "pnpm ensure:electron",
    "prebuild:local": "pnpm ensure:electron",
    "prebuild": "pnpm ensure:electron",
    "prebuild:electron": "pnpm ensure:electron",
    "build:mac:signed": "node scripts/build-mac-signed.mjs",
    "notarize:mac:status": "node scripts/notarize-status.mjs",
    "notarize:mac:staple": "node scripts/notarize-staple.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@cadencr/brand": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@lexical/react": "^0.46.0",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.2.11",
    "@pierre/trees": "1.0.0-beta.4",
    "@react-symbols/icons": "^1.4.1",
    "@replit/codemirror-vim": "^6.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/hotkeys": "0.8.0",
    "@tanstack/query-sync-storage-persister": "^4.43.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^4.43.0",
    "@tanstack/react-query-persist-client": "^4.43.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/router-vite-plugin": "1.167.18",
