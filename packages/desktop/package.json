    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.5",
    "jsdom": "29.1.1",
    "jsqr": "^1.4.0",
    "knip": "^6.22.0",
    "lexical": "^0.46.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.16.0",
    "msw": "^2",
    "orval": "7.21.0",
    "oxlint": "^1.71.0",
    "postcss": "8.5.18",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "react-virtuoso": "^4.18.10",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vitest": "4.1.9",
    "vscode-languageserver-protocol": "^3.18.1",
    "zustand": "^5.0.14"
  }
}
