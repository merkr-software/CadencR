{
  "name": "@cadencr/tab-kit",
  "version": "0.14.0",
  "description": "Cadencr's look for custom tabs: theme tokens, a Tailwind v4 preset, the Inter UI font, and the desktop app's React components.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merkr-software/CadencR.git",
    "directory": "packages/tab-kit"
  },
  "keywords": [
    "cadencr",
    "plugin",
    "custom-tab",
    "tailwindcss",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset.css": "./preset.css",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "ts-check": "tsc --noEmit",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "lint": "oxlint src/ scripts/ test/ example/src/",
    "lint:fix": "oxlint --fix src/ scripts/ test/ example/src/",
    "format": "oxfmt src/ scripts/ test/ example/ README.md *.css vite.config.ts",
    "format:check": "oxfmt --check src/ scripts/ test/ example/ README.md *.css vite.config.ts",
    "knip": "knip"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knip": "^6.39.0",
    "lucide-react": "^0.563.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
