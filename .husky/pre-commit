#!/bin/sh
set -u

cmd="pnpm turbo run format:check lint ts-check test knip"
log_file="$(mktemp -t cadencr-precommit-log.XXXXXX)" || exit 1
tmp_dir="$(mktemp -d -t cadencr-precommit.XXXXXX)" || {
  rm -f "$log_file"
  exit 1
}
stderr_pipe="$tmp_dir/stderr.pipe"

if mkfifo "$stderr_pipe"; then
  : >"$log_file"
  tee -a "$log_file" <"$stderr_pipe" >&2 &
  tee_pid=$!

  sh -c "$cmd" >>"$log_file" 2>"$stderr_pipe"
  status=$?

  wait "$tee_pid" 2>/dev/null || true
else
  sh -c "$cmd" >"$log_file" 2>&1
  status=$?
fi

rm -rf "$tmp_dir"

if [ "$status" -eq 0 ]; then
  rm -f "$log_file"
  exit 0
fi

echo "pre-commit failed: $cmd"
echo "full log: $log_file"
echo "stderr was streamed live; stdout and stderr were saved in the full log"
echo "the log can be large; use rg/grep to search for specific errors instead of printing it all"
echo "  rg -n \"error|failed|FAILED|panic\" \"$log_file\""
echo "rerun specific checks as needed, for example:"
echo "  pnpm turbo run format:check"
echo "  pnpm turbo run lint"
echo "  pnpm turbo run ts-check"
echo "  pnpm turbo run test"
echo "  pnpm turbo run knip"

exit "$status"
