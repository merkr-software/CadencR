{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadencr:lsp-blocklist:v1",
  "title": "Cadencr LSP revocation policy payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "expires_at", "entries"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "lsp-blocklist"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lsp_id", "reason"],
        "properties": {
          "lsp_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version_requirement": {
            "type": "string",
            "minLength": 1
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entry_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
