{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadencr:marketplace-lsp-package:v1",
  "title": "Cadencr schema-2 LSP package envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "package"],
  "properties": {
    "kind": {
      "const": "lsp"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lsp", "host"],
      "properties": {
        "lsp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "description",
            "version",
            "repository",
            "license",
            "protocol_version",
            "languages",
            "root_markers",
            "role",
            "args",
            "initialization_options",
            "distribution"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "protocol_version": {
              "const": 1
            },
            "languages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "extensions", "filenames"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "extensions": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "filenames": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              }
            },
            "root_markers": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "role": {
              "enum": ["type_checker", "linter", "formatter", "general"]
            },
            "args": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "initialization_options": {
              "type": "object"
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["binary"],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "binary": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 16,
                  "propertyNames": {
                    "enum": ["darwin-aarch64", "darwin-x86_64", "linux-x86_64"]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "archive",
                      "sha256",
                      "size",
                      "entry",
                      "entry_sha256",
                      "entry_size",
                      "runtime"
                    ],
                    "properties": {
                      "archive": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 67108864
                      },
                      "entry": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "entry_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "entry_size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 268435456
                      },
                      "runtime": {
                        "enum": ["native", "node"]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher", "compatibility"],
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "compatibility": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_app_version"],
              "properties": {
                "min_app_version": {
                  "type": "string",
                  "minLength": 1
                },
                "max_app_version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "assets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["icon"],
              "properties": {
                "icon": {
                  "type": "string",
                  "minLength": 1
                },
                "readme": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
